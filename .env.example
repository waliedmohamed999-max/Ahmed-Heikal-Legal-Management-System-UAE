# AH Legal OS — environment template. Copy to `.env` (local development) or `.env.staging`
# (staging stack) and fill in. NEVER commit a filled-in copy; staging/production secrets live in
# the secret manager and are injected at runtime.
#
# Categories
#   [REQUIRED]    staging AND production — the server/worker refuse to start without it
#   [PROD]        required whenever NODE_ENV=production (staging runs with NODE_ENV=production,
#                 so staging must satisfy these too — see docs/STAGING-SETUP.md)
#   [MIRROR]      not enforced, but staging should have it so it mirrors production (warned at boot)
#   [OPTIONAL]    optional integration — leave the provider at `none` to disable it
#   [ACK]         explicit acknowledgement of a known risk (production only; avoid)
#   [SECRET]      security-sensitive: secret manager only, never logged, never shared between
#                 environments (staging and production get DIFFERENT values)
#
# Example values below are deliberately unusable as real secrets: secrets are left blank, and
# the only sample credentials (`*_dev_only`) are rejected by the production validator.
# Generate each secret separately:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development                          # [REQUIRED] staging + production: production
APP_URL=http://localhost:3100                 # [PROD] public https:// URL (e.g. https://staging.example.ae)
CLIENT_PORTAL_URL=                            # [OPTIONAL] separate portal origin; https:// in production
PUBLIC_HOST=                                  # [OPTIONAL] host-based routing (public site / app / portal)
APP_HOST=
PORTAL_HOST=
PUBLIC_ORG_SLUG=ahmed-heikal                  # organisation served by the public site and create-owner
TRUSTED_PROXY_HOPS=1                          # [PROD] number of reverse proxies in front (0 = directly exposed)
CORS_ALLOWED_ORIGINS=                         # comma-separated; empty = same-origin only (recommended)

# ── Database: MySQL 8.4 (database of record) ─────────────────────────
# [REQUIRED][SECRET] Staging/production: the least-privilege APP user (see docs/PRODUCTION-CHECKLIST.md).
# Migrations run with a separate migration user (migrate job only).
DATABASE_URL=mysql://ahlegal:ahlegal_dev_only@127.0.0.1:3307/ahlegal_dev
# Local XAMPP (MariaDB 10.4, Windows) alternative for development only — not a staging target:
#   mysql://root@127.0.0.1:3306/ahmedhiekal
REDIS_URL=redis://localhost:6380              # [PROD] shared rate limits across instances

# ── Application secrets ──────────────────────────────────────────────
SESSION_SECRET=                               # [REQUIRED][SECRET] ≥32 chars; also keys reset/invite token hashes
DATA_ENCRYPTION_KEY=                          # [REQUIRED][SECRET] base64 of 32 bytes (Emirates ID, passport, MFA secrets)
FILE_SIGNING_SECRET=                          # [REQUIRED][SECRET] ≥32 chars (signed file links, form stamps)
BACKUP_ENCRYPTION_KEY=                        # [PROD][SECRET] base64 of 32 bytes; escrow offline (two sealed copies)
BACKUP_ENCRYPTION_KEYS_PREVIOUS=              # [SECRET] retired backup keys during rotation (comma-separated)

# ── Demo data ────────────────────────────────────────────────────────
# Must stay false in staging and production. The production server and worker refuse to start
# while demo data exists; `npm run db:seed:demo` is for local development only.
SEED_DEMO=false

# ── Object storage ───────────────────────────────────────────────────
STORAGE_DRIVER=local                          # [PROD] s3 (staging: s3 as well — MinIO or a private bucket)
STORAGE_LOCAL_DIR=./storage
STORAGE_LOCAL_ENCRYPTED_VOLUME=false          # [ACK] only if production uses local disk on an encrypted, backed-up volume
S3_BUCKET=                                    # [PROD] private bucket, block public access, versioning on
S3_REGION=
S3_ENDPOINT=                                  # set for MinIO / non-AWS (e.g. http://minio:9000)
S3_FORCE_PATH_STYLE=false                     # true for MinIO
S3_ACCESS_KEY_ID=                             # [SECRET] unless S3_USE_INSTANCE_ROLE=true
S3_SECRET_ACCESS_KEY=                         # [SECRET]
S3_USE_INSTANCE_ROLE=false
S3_SSE=AES256                                 # AES256 | aws:kms
S3_KMS_KEY_ID=
SIGNED_URL_TTL_SECONDS=300                    # 60–900
MAX_UPLOAD_MB=100

# ── Malware scanning ─────────────────────────────────────────────────
MALWARE_SCANNER=none                          # [PROD] clamav (staging: clamav)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3311
MALWARE_SCAN_NOT_CONFIGURED_ACK=false         # [ACK] production without a scanner — do not use in staging

# ── E-mail (password reset, invitations, reminders) ──────────────────
EMAIL_PROVIDER=none                           # [MIRROR] smtp — or explicitly none (admin one-time-link fallback)
SMTP_HOST=                                    # staging: a sandbox/catcher (e.g. Mailpit) so no mail reaches real people
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=                                # [SECRET]
SMTP_FROM=

# ── SMS / WhatsApp (official Business Cloud API only) ────────────────
SMS_PROVIDER=none                             # [OPTIONAL] twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                            # [SECRET]
TWILIO_FROM=
WHATSAPP_BUSINESS_PHONE_ID=                   # [OPTIONAL] set together with the token
WHATSAPP_BUSINESS_TOKEN=                      # [SECRET]
WHATSAPP_TEMPLATE_NAME=

# ── AI (off until a key is set AND an admin acknowledges + enables it) ─
AI_PROVIDER=anthropic                         # [OPTIONAL] anthropic | none
ANTHROPIC_API_KEY=                            # [SECRET] separate key per environment
AI_MODEL=claude-opus-5
AI_FALLBACK_MODEL=

# ── OCR (text PDF / DOCX built in; image OCR provider not bundled) ───
OCR_PROVIDER=none

# ── Public forms ─────────────────────────────────────────────────────
BOT_PROTECTION=none                           # [OPTIONAL] turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=                         # [SECRET]

# ── Backups ──────────────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=35
BACKUP_S3_BUCKET=                             # [MIRROR] off-server copy (different account / region)
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=                      # [SECRET] write-only credentials for the backup bucket
BACKUP_S3_SECRET_ACCESS_KEY=                  # [SECRET]
MYSQL_DOCKER_CONTAINER=                       # local development only: run mysqldump inside this container

# ── Operations ───────────────────────────────────────────────────────
MONITORING_DSN=                               # [MIRROR][SECRET] Sentry-compatible DSN (redacted events only)
LOG_LEVEL=info
RUN_WORKER_IN_PROCESS=                        # staging/production web: false (the worker runs separately)
WORKER_INTERVAL_MS=60000
