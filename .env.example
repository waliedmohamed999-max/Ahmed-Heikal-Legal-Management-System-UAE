# AH Legal OS — environment. Copy to .env for local development.
# Legend: [REQUIRED] server refuses to start without it · [PROD] required in production ·
#         [RECOMMENDED] warned about in production · [ACK] explicit acknowledgement of a risk
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Every secret must be different. Never commit a filled-in copy.

# ── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3100                 # [PROD] https:// public URL
CLIENT_PORTAL_URL=                            # optional, https:// in production
PUBLIC_HOST=
APP_HOST=
PORTAL_HOST=
TRUSTED_PROXY_HOPS=1                          # reverse proxies in front (0 = directly exposed)
CORS_ALLOWED_ORIGINS=                         # comma-separated; empty = same-origin only

# ── Database: MySQL 8.4 (database of record) ─────────────────────────
DATABASE_URL=mysql://ahlegal:ahlegal_dev_only@127.0.0.1:3307/ahlegal_dev   # [REQUIRED]
# XAMPP alternative: mysql://root@127.0.0.1:3306/ahmedhiekal
REDIS_URL=redis://localhost:6380              # [PROD] shared rate limits

# ── Secrets ──────────────────────────────────────────────────────────
SESSION_SECRET=                               # [REQUIRED] ≥32 chars (also keys reset/invite token hashes)
DATA_ENCRYPTION_KEY=                          # [REQUIRED] base64 32 bytes (Emirates ID, passport, MFA secrets)
FILE_SIGNING_SECRET=                          # [REQUIRED] ≥32 chars (signed file links, form stamps)
BACKUP_ENCRYPTION_KEY=                        # [PROD] base64 32 bytes; escrow offline
BACKUP_ENCRYPTION_KEYS_PREVIOUS=              # old backup keys during rotation (comma-separated)

# ── Demo data (development only; refused in production) ──────────────
SEED_DEMO=false

# ── Object storage ───────────────────────────────────────────────────
STORAGE_DRIVER=local                          # production: s3
STORAGE_LOCAL_DIR=./storage
STORAGE_LOCAL_ENCRYPTED_VOLUME=false          # [ACK] only if production uses local disk on an encrypted, backed-up volume
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=                                  # set for MinIO / non-AWS (e.g. http://127.0.0.1:9010)
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_INSTANCE_ROLE=false
S3_SSE=AES256                                 # AES256 | aws:kms
S3_KMS_KEY_ID=
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_MB=100

# ── Malware scanning ─────────────────────────────────────────────────
MALWARE_SCANNER=none                          # production: clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3311
MALWARE_SCAN_NOT_CONFIGURED_ACK=false         # [ACK] production without a scanner

# ── E-mail (password reset, invitations, reminders) ──────────────────
EMAIL_PROVIDER=none                           # smtp  (Microsoft 365 / Google Workspace SMTP relay, or a provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── SMS / WhatsApp (official Business Cloud API only) ────────────────
SMS_PROVIDER=none                             # twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_BUSINESS_PHONE_ID=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=

# ── AI (off until a key is set AND an admin acknowledges + enables it) ─
AI_PROVIDER=anthropic                         # anthropic | none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_FALLBACK_MODEL=

# ── OCR (text PDF / DOCX built in; image OCR provider not bundled) ───
OCR_PROVIDER=none

# ── Public forms ─────────────────────────────────────────────────────
BOT_PROTECTION=none                           # turnstile (optional challenge)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Backups ──────────────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=35
BACKUP_S3_BUCKET=                             # [RECOMMENDED] off-server copy (different account / region)
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
MYSQL_DOCKER_CONTAINER=                       # dev only: run mysqldump inside this container

# ── Operations ───────────────────────────────────────────────────────
MONITORING_DSN=                               # [RECOMMENDED] Sentry-compatible DSN (redacted events only)
LOG_LEVEL=info
RUN_WORKER_IN_PROCESS=                        # production web: false (the worker runs separately)
WORKER_INTERVAL_MS=60000
