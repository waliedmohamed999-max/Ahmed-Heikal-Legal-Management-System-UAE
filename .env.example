# ── Core ────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3100
# Optional host-based routing in production (public site / app / client portal)
PUBLIC_HOST=
APP_HOST=
PORTAL_HOST=

# ── Database / cache ────────────────────────────────────
DATABASE_URL=postgresql://ahlegal:ahlegal_dev_only@localhost:5434/ahlegal?schema=public
REDIS_URL=redis://localhost:6380

# ── Security (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
SESSION_SECRET=
# 32-byte base64 key used for AES-256-GCM field encryption (Emirates ID, passport, MFA secrets)
DATA_ENCRYPTION_KEY=
# HMAC key for signed document URLs
FILE_SIGNING_SECRET=

# ── Object storage ──────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── AI (disabled unless a key is provided and AI is enabled in Settings → AI) ──
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# ── OCR (image OCR requires a configured provider; PDF/DOCX text extraction is built in)
OCR_PROVIDER=none

# ── Messaging providers (Not Connected until configured) ──
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMS_PROVIDER=
WHATSAPP_BUSINESS_PHONE_ID=
WHATSAPP_BUSINESS_TOKEN=
