{
  "name": "ah-legal-os",
  "version": "0.1.0",
  "private": true,
  "description": "AH Legal OS — Legal Practice Management & Case Intelligence Platform for Ahmed Heikal Legal Consultancy (UAE)",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start -p 3100",
    "worker": "tsx --env-file-if-exists=.env --conditions=react-server src/worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed.ts --demo",
    "create-owner": "tsx --env-file-if-exists=.env --conditions=react-server scripts/create-owner.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.mts",
    "test:e2e": "playwright test",
    "backup": "tsx --env-file-if-exists=.env --conditions=react-server scripts/backup.ts",
    "build:tools": "node scripts/build-server-tools.mjs",
    "test:security": "vitest run -c vitest.integration.mts tests/security",
    "perf:large": "tsx --conditions=react-server scripts/perf-large.ts",
    "load-test": "node scripts/load-test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^5.9.1",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.3",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.12.3",
    "next": "^16.3.6",
    "nodemailer": "^10.0.10",
    "otplib": "^13.5.0",
    "pdf-parse": "^1.1.4",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "vitest": "^5.0.1"
  }
}
