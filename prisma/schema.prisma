// ═══════════════════════════ Integrations ═══════════════════════════════════

enum IntegrationStatus {
  CONNECTED
  NOT_CONNECTED
  REQUIRES_CONFIGURATION
  UNSUPPORTED
  ERROR
}

model Integration {
  id             String            @id @default(uuid()) @db.Char(36)
  organizationId String            @db.Char(36)
  provider       String            @db.VarChar(191) // MICROSOFT_365 | GOOGLE_WORKSPACE | SMTP | SMS | WHATSAPP_BUSINESS | S3 | ACCOUNTING | COURT_<X>
  category       String            @db.LongText // FEDERAL | LOCAL_COURTS | EMAIL | CALENDAR | STORAGE | SMS | WHATSAPP | ACCOUNTING | AI | OCR
  // Non-secret configuration only. Secrets live in environment / secret manager.
  config         Json              @default("{}")
  status         IntegrationStatus @default(NOT_CONNECTED)
  statusDetail   String?           @db.LongText
  lastCheckedAt  DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, provider])
}

// Court data import (manual workflow when no official API exists)
model CourtImport {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  matterId       String?      @db.Char(36)
  documentId     String?      @db.Char(36)
  sourceType     String       @db.LongText // PDF | EXCEL | CSV | EMAIL | IMAGE | MANUAL
  status         String       @default("PENDING_REVIEW") @db.VarChar(191) // PENDING_REVIEW | APPLIED | DISCARDED
  suggestions    Json         @default("[]")
  createdById    String?      @db.Char(36)
  reviewedById   String?      @db.Char(36)
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
}

// ═══════════════════════════ Governance ═════════════════════════════════════

// Append-only. UPDATE/DELETE are blocked by a database trigger (see migration),
// and each row is hash-chained to the previous one for tamper evidence.
model AuditLog {
  id             String       @id @default(uuid()) @db.Char(36)
  seq            BigInt       @default(autoincrement())
  organizationId String       @db.Char(36)
  actorId        String?      @db.Char(36)
  action         String       @db.VarChar(191) // auth.login, matter.viewed, document.downloaded, permission.changed …
  entityType     String?      @db.VarChar(191)
  entityId       String?      @db.VarChar(191)
  matterId       String?      @db.Char(36)
  ip             String?      @db.LongText
  userAgent      String?      @db.LongText
  sessionId      String?      @db.Char(36)
  before         Json?
  after          Json?
  metadata       Json?
  prevHash       String?      @db.LongText
  hash           String       @db.LongText
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  actor          User?        @relation(fields: [actorId], references: [id])
  matter         Matter?      @relation(fields: [matterId], references: [id])

  @@unique([seq])
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model AccessRequest {
  id             String            @id @default(uuid()) @db.Char(36)
  organizationId String            @db.Char(36)
  matterId       String            @db.Char(36)
  requesterId    String            @db.Char(36)
  reason         String?           @db.LongText
  status         RequestStatus     @default(PENDING)
  grantedRole    MatterMemberRole?
  expiresAt      DateTime?
  decidedById    String?           @db.Char(36)
  decidedAt      DateTime?
  decisionNote   String?           @db.LongText
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id])
  matter         Matter            @relation(fields: [matterId], references: [id])
  requester      User              @relation("AccessRequester", fields: [requesterId], references: [id])
  decidedBy      User?             @relation("AccessDecider", fields: [decidedById], references: [id])

  @@index([organizationId, status])
}

model Approval {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  kind           String       @db.LongText // DOCUMENT | CASE_CHANGE | FINANCIAL | CLIENT_COMMUNICATION | DEADLINE_VERIFICATION | AI_TIMELINE
  entityType     String       @db.VarChar(191)
  entityId       String       @db.Char(36)
  matterId       String?      @db.Char(36)
  title          String       @db.LongText
  payload        Json?
  requestedById  String?      @db.Char(36)
  assignedToId   String?      @db.Char(36)
  status         String       @default("PENDING") @db.VarChar(191) // PENDING | APPROVED | REJECTED | CHANGES_REQUESTED
  comment        String?      @db.LongText
  decidedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  matter         Matter?      @relation(fields: [matterId], references: [id])
  requestedBy    User?        @relation("ApprovalRequester", fields: [requestedById], references: [id])
  assignedTo     User?        @relation("ApprovalAssignee", fields: [assignedToId], references: [id])

  @@index([organizationId, status])
  @@index([entityType, entityId])
}

model AIJob {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  userId         String       @db.Char(36)
  matterId       String?      @db.Char(36)
  kind           String       @db.LongText // CASE_BRIEF | DOCUMENT_SUMMARY | EXTRACT_DATES | TIMELINE_DRAFT | HEARING_BRIEF | DRAFT | TRANSLATE | ASK
  status         String       @default("QUEUED") @db.VarChar(191) // QUEUED | RUNNING | SUCCEEDED | FAILED
