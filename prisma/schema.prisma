// ─────────────────────────────────────────────────────────────────────────────
// AH Legal OS — data model
//
// Conventions
// • Every tenant-owned row carries organizationId (single tenant in v1, SaaS-ready).
// • UUID primary keys, createdAt/updatedAt everywhere, createdById/updatedById on
//   user-authored records, deletedAt soft delete where records must be recoverable.
// • All DateTime values are stored in UTC and presented in the org timezone
//   (Asia/Dubai by default).
// • Money is Decimal(14,2); currency defaults to AED.
// • "Matter" is the core legal record. The UI calls it "Case" / "القضية"; its
//   `kind` distinguishes court cases, consultations, contracts, disputes, etc.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════ Tenancy & identity ═════════════════════════════

model Organization {
  id            String   @id @default(uuid()) @db.Char(36)
  slug          String   @unique @db.VarChar(191)
  name          String   @db.LongText
  nameAr        String?  @db.LongText
  timezone      String   @default("Asia/Dubai") @db.VarChar(191)
  currency      String   @default("AED") @db.VarChar(191)
  defaultLocale String   @default("ar") @db.VarChar(191)
  vatRate       Decimal  @default(5) @db.Decimal(5, 2)
  matterPrefix  String   @default("AH") @db.VarChar(191)
  invoicePrefix String   @default("INV") @db.VarChar(191)
  trn           String?  @db.LongText // UAE Tax Registration Number
  address       String?  @db.LongText
  phone         String?  @db.LongText
  email         String?  @db.LongText
  // Alert thresholds, retention, AI & privacy configuration (validated by zod in app code)
  settings      Json     @default("{}")
  isDemo        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users              User[]
  roles              Role[]
  teams              Team[]
  clients            Client[]
  contacts           Contact[]
  matters            Matter[]
  jurisdictions      Jurisdiction[]
  courts             Court[]
  caseCategories     CaseCategory[]
  caseTypes          CaseType[]
  workflows          Workflow[]
  checklistTemplates ChecklistTemplate[]
  hearings           Hearing[]
  deadlines          Deadline[]
  appointments       Appointment[]
  tasks              Task[]
  documents          Document[]
  notifications      Notification[]
  invoices           Invoice[]
  payments           Payment[]
  expenses           Expense[]
  timeEntries        TimeEntry[]
  leads              Lead[]
  pipelineStages     PipelineStage[]
  communications     Communication[]
  templates          Template[]
  knowledgeDocs      KnowledgeDocument[]
  integrations       Integration[]
  auditLogs          AuditLog[]
  accessRequests     AccessRequest[]
  approvals          Approval[]
  aiJobs             AIJob[]
  automations        Automation[]
  reminderPolicies   ReminderPolicy[]
  reminders          Reminder[]
  activities         Activity[]
  counters           Counter[]
  legalResources     LegalResource[]
  practiceAreas      PracticeArea[]
  articles           Article[]
  faqs               Faq[]
  testimonials       Testimonial[]
  bookingRequests    BookingRequest[]
  savedViews         SavedView[]
  imports            CourtImport[]
  backups            BackupRecord[]
  privacyRequests    PrivacyRequest[]
  breachLogs         BreachLog[]
  siteSettings       SiteSetting[]
  authTokens         AuthToken[]
}

enum UserKind {
  STAFF
  CLIENT
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model User {
  id                  String     @id @default(uuid()) @db.Char(36)
  organizationId      String     @db.Char(36)
  kind                UserKind   @default(STAFF)
  email               String     @unique @db.VarChar(191)
  name                String     @db.LongText
  nameAr              String?    @db.LongText
  position            String?    @db.LongText
  positionAr          String?    @db.LongText
  phone               String?    @db.LongText
  photoUrl            String?    @db.LongText
  passwordHash        String     @db.LongText
  status              UserStatus @default(ACTIVE)
  roleId              String     @db.Char(36)
  locale              String     @default("ar") @db.VarChar(191)
  // MFA (TOTP). Secret is AES-GCM encrypted at rest.
  mfaEnabled          Boolean    @default(false)
  mfaSecretEnc        String?    @db.LongText
  // Last accepted TOTP time-step: a code can be used once only (replay protection).
  mfaLastStep         Int?
  // Secret being enrolled; replaces mfaSecretEnc only after a valid code is confirmed.
  mfaPendingSecretEnc String?
  mfaEnrolledAt       DateTime?
  failedLoginCount    Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  // Offboarding: the account is disabled and its work transferred; history is kept.
  offboardedAt        DateTime?
  // Portal users are bound to exactly one client
  clientId            String?    @db.Char(36)
  // Dashboard widgets, notification channel prefs, etc.
  preferences         Json       @default("{}")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id])
  role                Role                 @relation(fields: [roleId], references: [id])
  client              Client?              @relation("PortalUsers", fields: [clientId], references: [id])
  sessions            Session[]
  teamMemberships     TeamMember[]
  matterMemberships   MatterMember[]       @relation("MemberUser")
  grantedMemberships  MatterMember[]       @relation("MemberGrantedBy")
  ledMatters          Matter[]             @relation("LeadLawyer")
  ownedMatters        Matter[]             @relation("MatterOwner")
  assignedTasks       Task[]               @relation("TaskAssignee")
  createdTasks        Task[]               @relation("TaskCreator")
  attendingHearings   Hearing[]            @relation("HearingLawyer")
  deadlinesAssigned   Deadline[]           @relation("DeadlineAssignee")
  deadlinesVerified   Deadline[]           @relation("DeadlineVerifier")
  appointments        Appointment[]        @relation("AppointmentLawyer")
  notifications       Notification[]
  comments            Comment[]
  notes               Note[]
  timeEntries         TimeEntry[]
  auditLogs           AuditLog[]
  accessRequests      AccessRequest[]      @relation("AccessRequester")
  accessDecisions     AccessRequest[]      @relation("AccessDecider")
  approvalsRequested  Approval[]           @relation("ApprovalRequester")
  approvalsAssigned   Approval[]           @relation("ApprovalAssignee")
  aiJobs              AIJob[]
  documentVersions    DocumentVersion[]
  leadsAssigned       Lead[]
  pushSubscriptions   PushSubscription[]
  recoveryCodes       MfaRecoveryCode[]
  authTokens          AuthToken[]          @relation("TokenUser")
  reminders           Reminder[]
  activities          Activity[]
  savedViews          SavedView[]
  documentPermissions DocumentPermission[]
  articles            Article[]

  @@index([organizationId, kind, status])
}

model Session {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String    @db.Char(36)
  tokenHash   String    @unique @db.VarChar(191)
  realm       UserKind
  mfaVerified Boolean   @default(false)
  // Last successful re-authentication (password / MFA) for sensitive actions.
  stepUpAt    DateTime?
  ip          String?   @db.LongText
  userAgent   String?   @db.LongText
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

// One-time MFA recovery codes. Only an Argon2 hash is stored; each code works once.
model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  codeHash  String    @db.LongText
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AuthTokenKind {
  PASSWORD_RESET
  INVITATION
}

// One-time tokens (password reset, invitation). Only the SHA-256 of the token is stored.
model AuthToken {
  id             String        @id @default(uuid()) @db.Char(36)
  organizationId String        @db.Char(36)
  kind           AuthTokenKind
  tokenHash      String        @unique @db.VarChar(191)
  email          String        @db.VarChar(191)
  userId         String?       @db.Char(36)
  // Invitation payload
  roleId         String?       @db.Char(36)
  name           String?       @db.LongText
  matterIds      Json          @default("[]")
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  createdById    String?       @db.Char(36)
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id])
  user           User?         @relation("TokenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, usedAt])
  @@index([email, kind])
}

// Small key/value table for operational state: worker heartbeat, last backup/restore test, integrity sweep.
model SystemStatus {
  key       String   @id @db.VarChar(191)
  value     Json
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  endpoint  String   @unique @db.VarChar(191)
  p256dh    String   @db.LongText
  auth      String   @db.LongText
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════ RBAC ═══════════════════════════════════════════

enum MatterScope {
  ALL // may see every non-confidential matter
  ASSIGNED // only matters where the user is an active member
  NONE // no matter access (e.g. Finance-only, Client)
}

model Role {
  id             String      @id @default(uuid()) @db.Char(36)
  organizationId String      @db.Char(36)
  key            String      @db.VarChar(191)
  name           String      @db.LongText
  nameAr         String?     @db.LongText
  description    String?     @db.LongText
  isSystem       Boolean     @default(false)
  matterScope    MatterScope @default(ASSIGNED)
  // Users with this role must enrol in MFA before they can use the app.
  requireMfa     Boolean     @default(false)
  rank           Int         @default(0) // for display ordering only, never for access decisions
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id])
  permissions         RolePermission[]
  users               User[]
  documentPermissions DocumentPermission[]

  @@unique([organizationId, key])
}

model Permission {
  key         String           @id @db.VarChar(191) // e.g. "matters.create", "documents.approve"
  module      String           @db.LongText
  action      String           @db.LongText
  description String?          @db.LongText
  roles       RolePermission[]
}

model RolePermission {
  roleId        String     @db.Char(36)
  permissionKey String     @db.VarChar(191)
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
}

model Team {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  name           String       @db.LongText
  nameAr         String?      @db.LongText
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  members        TeamMember[]
}

model TeamMember {
  teamId String @db.Char(36)
  userId String @db.Char(36)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

// ═══════════════════════════ Jurisdiction engine ════════════════════════════
// Nothing procedural is hard-coded: authorities, courts, categories, case types,
// workflows and stages are all admin-managed data.

enum JurisdictionKind {
  FEDERAL
  LOCAL
  FREE_ZONE
  ARBITRATION
  OTHER
}

model Jurisdiction {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @db.Char(36)
  code           String           @db.VarChar(191)
  name           String           @db.LongText
  nameAr         String?          @db.LongText
  kind           JurisdictionKind
  emirate        String?          @db.LongText
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id])
  courts         Court[]
  matters        Matter[]
  workflows      Workflow[]

  @@unique([organizationId, code])
}

model Court {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  jurisdictionId String       @db.Char(36)
  name           String       @db.LongText
  nameAr         String?      @db.LongText
  level          String?      @db.LongText // e.g. First Instance, Appeal, Cassation — admin-defined label
  emirate        String?      @db.LongText
  address        String?      @db.LongText
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id])
  matters        Matter[]
  hearings       Hearing[]

  @@index([organizationId, jurisdictionId])
}

model CaseCategory {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  name           String       @db.LongText
  nameAr         String?      @db.LongText
  order          Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id])
  caseTypes      CaseType[]
}

model CaseType {
  id                 String              @id @default(uuid()) @db.Char(36)
  organizationId     String              @db.Char(36)
  categoryId         String?             @db.Char(36)
  code               String              @db.VarChar(191)
  name               String              @db.LongText
  nameAr             String?             @db.LongText
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id])
  category           CaseCategory?       @relation(fields: [categoryId], references: [id])
  matters            Matter[]
  workflows          Workflow[]
  checklistTemplates ChecklistTemplate[]

  @@unique([organizationId, code])
}

model Workflow {
  id             String          @id @default(uuid()) @db.Char(36)
  organizationId String          @db.Char(36)
  name           String          @db.LongText
  nameAr         String?         @db.LongText
  jurisdictionId String?         @db.Char(36)
  caseTypeId     String?         @db.Char(36)
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id])
  jurisdiction   Jurisdiction?   @relation(fields: [jurisdictionId], references: [id])
  caseType       CaseType?       @relation(fields: [caseTypeId], references: [id])
  stages         WorkflowStage[]
}

model WorkflowStage {
  id         String   @id @default(uuid()) @db.Char(36)
  workflowId String   @db.Char(36)
  order      Int
  key        String   @db.VarChar(191)
  name       String   @db.LongText
  nameAr     String?  @db.LongText
  isTerminal Boolean  @default(false)
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  matters    Matter[]

  @@unique([workflowId, key])
}

model ChecklistTemplate {
  id             String                  @id @default(uuid()) @db.Char(36)
  organizationId String                  @db.Char(36)
  caseTypeId     String?                 @db.Char(36)
  name           String                  @db.LongText
  nameAr         String?                 @db.LongText
  active         Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  organization   Organization            @relation(fields: [organizationId], references: [id])
  caseType       CaseType?               @relation(fields: [caseTypeId], references: [id])
  items          ChecklistTemplateItem[]
}

model ChecklistTemplateItem {
  id         String            @id @default(uuid()) @db.Char(36)
  templateId String            @db.Char(36)
  order      Int
  title      String            @db.LongText
  titleAr    String?           @db.LongText
  required   Boolean           @default(false)
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════ Clients & contacts ═════════════════════════════

enum PartyType {
  INDIVIDUAL
  COMPANY
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

model Client {
  id                String       @id @default(uuid()) @db.Char(36)
  organizationId    String       @db.Char(36)
  clientNumber      String       @db.VarChar(191)
  type              PartyType
  nameEn            String       @db.VarChar(191)
  nameAr            String?      @db.LongText
  email             String?      @db.LongText
  phone             String?      @db.LongText
  whatsapp          String?      @db.LongText
  address           String?      @db.LongText
  nationality       String?      @db.LongText
  preferredLanguage String       @default("ar") @db.VarChar(191)
  tradeLicenseNo    String?      @db.LongText
  companyName       String?      @db.LongText
  // Sensitive identifiers — AES-GCM encrypted, shown only with clients.viewSensitive
  emiratesIdEnc     String?      @db.LongText
  passportEnc       String?      @db.LongText
  status            ClientStatus @default(ACTIVE)
  source            String?      @db.LongText
  notes             String?      @db.LongText
  leadId            String?      @unique @db.Char(36)
  lastContactAt     DateTime?
  createdById       String?      @db.Char(36)
  updatedById       String?      @db.Char(36)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  organization   Organization    @relation(fields: [organizationId], references: [id])
  lead           Lead?           @relation("LeadConversion", fields: [leadId], references: [id])
  contacts       Contact[]
  matters        Matter[]
  invoices       Invoice[]
  appointments   Appointment[]
  documents      Document[]
  communications Communication[]
  portalUsers    User[]          @relation("PortalUsers")

  @@unique([organizationId, clientNumber])
  @@index([organizationId, deletedAt])
  @@index([nameEn])
}

enum ContactCategory {
  CLIENT
  OPPONENT
  LAWYER
  EXPERT
  TRANSLATOR
  WITNESS
  COMPANY
  GOVERNMENT
  OTHER
}

model Contact {
  id             String          @id @default(uuid()) @db.Char(36)
  organizationId String          @db.Char(36)
  type           PartyType       @default(INDIVIDUAL)
  category       ContactCategory
  nameEn         String          @db.VarChar(191)
  nameAr         String?         @db.LongText
  companyName    String?         @db.LongText
  jobTitle       String?         @db.LongText
  email          String?         @db.LongText
  phone          String?         @db.LongText
  whatsapp       String?         @db.LongText
  address        String?         @db.LongText
  nationality    String?         @db.LongText
  notes          String?         @db.LongText
  clientId       String?         @db.Char(36) // contact person of a client company
  createdById    String?         @db.Char(36)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  organization  Organization      @relation(fields: [organizationId], references: [id])
  client        Client?           @relation(fields: [clientId], references: [id])
  parties       MatterParty[]
  relationsFrom ContactRelation[] @relation("RelFrom")
  relationsTo   ContactRelation[] @relation("RelTo")

  @@index([organizationId, category])
  @@index([nameEn])
}

// Entity relationship graph: person ↔ company, subsidiary, director, etc.
model ContactRelation {
  id        String   @id @default(uuid()) @db.Char(36)
  fromId    String   @db.Char(36)
  toId      String   @db.Char(36)
  label     String   @db.VarChar(191) // e.g. "Director of", "Subsidiary of"
  createdAt DateTime @default(now())
  from      Contact  @relation("RelFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        Contact  @relation("RelTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, label])
}

// ═══════════════════════════ Matters (cases) ════════════════════════════════

enum MatterKind {
  COURT_CASE
  CONSULTATION
  CONTRACT
  DISPUTE
  EXECUTION
  APPEAL
  ARBITRATION
  OTHER
}

enum MatterStatus {
  INTAKE
  ACTIVE
  PENDING
  ON_HOLD
  CLOSED
  ARCHIVED
}

enum Priority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum Confidentiality {
  STANDARD
  CONFIDENTIAL
  HIGHLY_CONFIDENTIAL
}

enum BillingType {
  NONE
  FIXED
  HOURLY
  RETAINER
  INSTALLMENTS
}

enum ConflictStatus {
  NOT_RUN
  CLEAR
  POTENTIAL_MATCH_REVIEWED
  WAIVED
}

model Matter {
  id                  String          @id @default(uuid()) @db.Char(36)
  organizationId      String          @db.Char(36)
  // Internal number (AH-2026-00001) is independent of the official court case number.
  internalNumber      String          @db.VarChar(191)
  officialCaseNumber  String?         @db.VarChar(191)
  title               String          @db.LongText
  titleAr             String?         @db.LongText
  summary             String?         @db.LongText
  kind                MatterKind      @default(COURT_CASE)
  status              MatterStatus    @default(ACTIVE)
  priority            Priority        @default(NORMAL)
  confidentiality     Confidentiality @default(STANDARD)
  clientId            String          @db.Char(36)
  caseTypeId          String?         @db.Char(36)
  jurisdictionId      String?         @db.Char(36)
  courtId             String?         @db.Char(36)
  stageId             String?         @db.Char(36)
  ownerId             String          @db.Char(36)
  leadLawyerId        String?         @db.Char(36)
  claimAmount         Decimal?        @db.Decimal(16, 2)
  currency            String          @default("AED") @db.VarChar(191)
  claims              String?         @db.LongText
  internalNotes       String?         @db.LongText
  currentStatusText   String?         @db.LongText
  lastActionText      String?         @db.LongText
  nextActionText      String?         @db.LongText
  riskFlags           Json            @default("[]")
  billingType         BillingType     @default(NONE)
  feeAmount           Decimal?        @db.Decimal(14, 2)
  hourlyRate          Decimal?        @db.Decimal(10, 2)
  feeNotes            String?         @db.LongText
  conflictStatus      ConflictStatus  @default(NOT_RUN)
  conflictNotes       String?         @db.LongText
  conflictCheckedById String?         @db.Char(36)
  conflictCheckedAt   DateTime?
  portalEnabled       Boolean         @default(false)
  portalStatusText    String?         @db.LongText
  openedAt            DateTime        @default(now())
  closedAt            DateTime?
  lastActivityAt      DateTime        @default(now())
  createdById         String?         @db.Char(36)
  updatedById         String?         @db.Char(36)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  organization   Organization          @relation(fields: [organizationId], references: [id])
  client         Client                @relation(fields: [clientId], references: [id])
  caseType       CaseType?             @relation(fields: [caseTypeId], references: [id])
  jurisdiction   Jurisdiction?         @relation(fields: [jurisdictionId], references: [id])
  court          Court?                @relation(fields: [courtId], references: [id])
  stage          WorkflowStage?        @relation(fields: [stageId], references: [id])
  owner          User                  @relation("MatterOwner", fields: [ownerId], references: [id])
  leadLawyer     User?                 @relation("LeadLawyer", fields: [leadLawyerId], references: [id])
  members        MatterMember[]
  parties        MatterParty[]
  checklist      MatterChecklistItem[]
  hearings       Hearing[]
  deadlines      Deadline[]
  appointments   Appointment[]
  tasks          Task[]
  documents      Document[]
  notes          Note[]
  comments       Comment[]
  timeline       TimelineEvent[]
  activities     Activity[]
  communications Communication[]
  invoices       Invoice[]
  expenses       Expense[]
  timeEntries    TimeEntry[]
  accessRequests AccessRequest[]
  approvals      Approval[]
  aiJobs         AIJob[]
  auditLogs      AuditLog[]

  @@unique([organizationId, internalNumber])
  @@index([organizationId, status, deletedAt])
  @@index([organizationId, clientId])
  @@index([officialCaseNumber])
  @@index([lastActivityAt])
}

enum MatterMemberRole {
  OWNER
  LEAD
  ASSIGNED
  ASSISTANT
  OBSERVER
  DOCUMENTS_ONLY
}

model MatterMember {
  id          String           @id @default(uuid()) @db.Char(36)
  matterId    String           @db.Char(36)
  userId      String           @db.Char(36)
  role        MatterMemberRole
  // Per-member overrides on top of the member-role defaults: "+documents.upload", "-finance.view"
  overrides   Json             @default("[]")
  // Temporary access: revoked automatically after this instant
  expiresAt   DateTime?
  grantedById String?          @db.Char(36)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  matter    Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  user      User   @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User?  @relation("MemberGrantedBy", fields: [grantedById], references: [id])

  @@unique([matterId, userId])
  @@index([userId])
}

enum PartyRole {
  CLIENT
  OPPONENT
  OPPONENT_COUNSEL
  CO_CLAIMANT
  CO_DEFENDANT
  WITNESS
  EXPERT
  THIRD_PARTY
  RELATED
}

model MatterParty {
  id        String    @id @default(uuid()) @db.Char(36)
  matterId  String    @db.Char(36)
  contactId String    @db.Char(36)
  role      PartyRole
  notes     String?   @db.LongText
  createdAt DateTime  @default(now())
  matter    Matter    @relation(fields: [matterId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id])

  @@unique([matterId, contactId, role])
  @@index([contactId])
}

model MatterChecklistItem {
  id       String    @id @default(uuid()) @db.Char(36)
  matterId String    @db.Char(36)
  order    Int
  title    String    @db.LongText
  titleAr  String?   @db.LongText
  required Boolean   @default(false)
  doneAt   DateTime?
  doneById String?   @db.Char(36)
  matter   Matter    @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([matterId])
}

enum TimelineSource {
  MANUAL
  SYSTEM
  AI
  IMPORT
}

enum ProposalStatus {
  CONFIRMED
  PROPOSED
  REJECTED
}

model TimelineEvent {
  id          String         @id @default(uuid()) @db.Char(36)
  matterId    String         @db.Char(36)
  eventType   String         @db.LongText // CASE_CREATED, CLAIM_SUBMITTED, HEARING, JUDGMENT, ... (admin-extendable)
  occurredAt  DateTime
  title       String         @db.LongText
  description String?        @db.LongText
  notes       String?        @db.LongText
  documentIds Json           @default("[]")
  source      TimelineSource @default(MANUAL)
  status      ProposalStatus @default(CONFIRMED)
  // For AI proposals: where the fact came from
  citations   Json?
  userId      String?        @db.Char(36)
  decidedById String?        @db.Char(36)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  matter      Matter         @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([matterId, occurredAt])
}

// ═══════════════════════════ Hearings, deadlines, appointments ══════════════

enum HearingStatus {
  SCHEDULED
  PREPARING
  READY
  HELD
  ADJOURNED
  CANCELLED
}

enum Attendance {
  REQUIRED
  OPTIONAL
  NOT_REQUIRED
}

model Hearing {
  id                String        @id @default(uuid()) @db.Char(36)
  organizationId    String        @db.Char(36)
  matterId          String        @db.Char(36)
  courtId           String?       @db.Char(36)
  courtRoom         String?       @db.LongText
  isRemote          Boolean       @default(false)
  remoteUrl         String?       @db.LongText
  startsAt          DateTime
  endsAt            DateTime?
  judge             String?       @db.LongText
  sessionType       String?       @db.LongText
  attendingLawyerId String?       @db.Char(36)
  clientAttendance  Attendance    @default(NOT_REQUIRED)
  status            HearingStatus @default(SCHEDULED)
  requiredDocuments String?       @db.LongText
  preparationNotes  String?       @db.LongText
  questions         String?       @db.LongText
  arguments         String?       @db.LongText
  // Hearing report (filled after the session)
  outcome           String?       @db.LongText
  decisions         String?       @db.LongText
  requiredActions   String?       @db.LongText
  reportedAt        DateTime?
  reportedById      String?       @db.Char(36)
  previousHearingId String?       @unique @db.Char(36)
  acknowledgedAt    DateTime? // attending lawyer acknowledged the reminder
  createdById       String?       @db.Char(36)
  updatedById       String?       @db.Char(36)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id])
  matter          Matter       @relation(fields: [matterId], references: [id])
  court           Court?       @relation(fields: [courtId], references: [id])
  attendingLawyer User?        @relation("HearingLawyer", fields: [attendingLawyerId], references: [id])
  previousHearing Hearing?     @relation("HearingChain", fields: [previousHearingId], references: [id])
  nextHearing     Hearing?     @relation("HearingChain")
  deadlines       Deadline[]

  @@index([organizationId, startsAt])
  @@index([matterId, startsAt])
}

enum DeadlineType {
  SUBMISSION
  APPEAL
  PAYMENT
  DOCUMENT
  EXPERT_MEETING
  COURT_APPOINTMENT
  RENEWAL
  FOLLOW_UP
  INTERNAL
  OTHER
}

enum DeadlineStatus {
  OPEN
  DONE
  MISSED
  CANCELLED
}

enum Verification {
  CONFIRMED
  NEEDS_VERIFICATION
}

enum EventSource {
  MANUAL
  HEARING_REPORT
  AI
  IMPORT
  AUTOMATION
}

model Deadline {
  id             String         @id @default(uuid()) @db.Char(36)
  organizationId String         @db.Char(36)
  matterId       String?        @db.Char(36)
  hearingId      String?        @db.Char(36)
  type           DeadlineType
  title          String         @db.LongText
  description    String?        @db.LongText
  dueAt          DateTime
  isCritical     Boolean        @default(false)
  assigneeId     String?        @db.Char(36)
  status         DeadlineStatus @default(OPEN)
  // AI/import-extracted legal deadlines stay NEEDS_VERIFICATION until an authorised lawyer confirms.
  verification   Verification   @default(CONFIRMED)
  source         EventSource    @default(MANUAL)
  verifiedById   String?        @db.Char(36)
  verifiedAt     DateTime?
  completedAt    DateTime?
  acknowledgedAt DateTime?
  createdById    String?        @db.Char(36)
  updatedById    String?        @db.Char(36)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  matter       Matter?      @relation(fields: [matterId], references: [id])
  hearing      Hearing?     @relation(fields: [hearingId], references: [id])
  assignee     User?        @relation("DeadlineAssignee", fields: [assigneeId], references: [id])
  verifiedBy   User?        @relation("DeadlineVerifier", fields: [verifiedById], references: [id])

  @@index([organizationId, status, dueAt])
  @@index([matterId])
}

enum AppointmentType {
  CONSULTATION
  FOLLOW_UP
  DOCUMENT_SIGNING
  CASE_MEETING
  ONLINE_MEETING
  INTERNAL_MEETING
  CALL
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id             String            @id @default(uuid()) @db.Char(36)
  organizationId String            @db.Char(36)
  type           AppointmentType
  title          String            @db.LongText
  startsAt       DateTime
  endsAt         DateTime
  lawyerId       String?           @db.Char(36)
  clientId       String?           @db.Char(36)
  leadId         String?           @db.Char(36)
  matterId       String?           @db.Char(36)
  location       String?           @db.LongText
  meetingUrl     String?           @db.LongText
  notes          String?           @db.LongText
  status         AppointmentStatus @default(CONFIRMED)
  portalVisible  Boolean           @default(false)
  createdById    String?           @db.Char(36)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  lawyer       User?        @relation("AppointmentLawyer", fields: [lawyerId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])
  lead         Lead?        @relation(fields: [leadId], references: [id])
  matter       Matter?      @relation(fields: [matterId], references: [id])

  @@index([organizationId, startsAt])
}

// Reminder rules: which offsets (minutes before) fire for which event type.
model ReminderPolicy {
  id                    String       @id @default(uuid()) @db.Char(36)
  organizationId        String       @db.Char(36)
  subjectType           String       @db.VarChar(191) // HEARING | DEADLINE | APPOINTMENT | TASK
  offsetsMinutes        Json         @default("[]")
  channels              Json         @default("[\"IN_APP\"]")
  notifyOwner           Boolean      @default(false)
  // Escalate to matter owner if the assignee has not acknowledged this many minutes before the event
  escalateBeforeMinutes Int?
  enabled               Boolean      @default(true)
  updatedAt             DateTime     @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, subjectType])
}

enum ReminderStatus {
  PENDING
  PROCESSING
  SENT
  CANCELLED
  FAILED
}

// Materialised, schedulable reminders. Regenerated whenever the underlying event changes.
model Reminder {
  id             String         @id @default(uuid()) @db.Char(36)
  organizationId String         @db.Char(36)
  subjectType    String         @db.VarChar(191)
  subjectId      String         @db.Char(36)
  userId         String         @db.Char(36)
  fireAt         DateTime
  offsetMinutes  Int
  kind           String         @default("REMINDER") @db.VarChar(191) // REMINDER | ESCALATION
  channels       Json           @default("[]")
  status         ReminderStatus @default(PENDING)
  sentAt         DateTime?
  error          String?        @db.LongText
  // Durable job bookkeeping: a crashed worker's claim expires (lockedUntil) and the job is retried.
  attempts       Int            @default(0)
  lastAttemptAt  DateTime?
  lockedUntil    DateTime?
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id])
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, fireAt])
  @@index([subjectType, subjectId])
}

// ═══════════════════════════ Tasks ══════════════════════════════════════════

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING
  DONE
  CANCELLED
}

model Task {
  id              String     @id @default(uuid()) @db.Char(36)
  organizationId  String     @db.Char(36)
  matterId        String?    @db.Char(36)
  title           String     @db.LongText
  description     String?    @db.LongText
  assigneeId      String?    @db.Char(36)
  createdById     String?    @db.Char(36)
  priority        Priority   @default(NORMAL)
  status          TaskStatus @default(TODO)
  startAt         DateTime?
  dueAt           DateTime?
  estimateMinutes Int?
  completedAt     DateTime?
  // Origin, e.g. HEARING:<id>, AUTOMATION:<key>
  sourceType      String?    @db.VarChar(191)
  sourceId        String?    @db.Char(36)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id])
  matter       Matter?             @relation(fields: [matterId], references: [id])
  assignee     User?               @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy    User?               @relation("TaskCreator", fields: [createdById], references: [id])
  checklist    TaskChecklistItem[]
  comments     Comment[]
  dependsOn    TaskDependency[]    @relation("Dependent")
  blocks       TaskDependency[]    @relation("Blocker")

  @@index([organizationId, assigneeId, status])
  @@index([organizationId, deletedAt, status, dueAt])
  @@index([matterId])
  @@index([dueAt])
  @@index([sourceType, sourceId])
}

model TaskChecklistItem {
  id     String    @id @default(uuid()) @db.Char(36)
  taskId String    @db.Char(36)
  order  Int
  title  String    @db.LongText
  doneAt DateTime?
  task   Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskDependency {
  taskId      String @db.Char(36)
  dependsOnId String @db.Char(36)
  task        Task   @relation("Dependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task   @relation("Blocker", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
}

// ═══════════════════════════ Documents ══════════════════════════════════════

enum DocumentCategory {
  COURT
  CLIENT
  EVIDENCE
  CONTRACT
  LEGAL_MEMO
  CORRESPONDENCE
  JUDGMENT
  INVOICE
  POWER_OF_ATTORNEY
  EXPERT_REPORT
  SUBMISSION
  OTHER
}

enum DocumentStatus {
  DRAFT
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SUBMITTED
}

enum ProcessingStatus {
  NOT_REQUIRED
  PENDING
  PROCESSING
  DONE
  FAILED
  UNAVAILABLE
}

model Document {
  id              String           @id @default(uuid()) @db.Char(36)
  organizationId  String           @db.Char(36)
  matterId        String?          @db.Char(36)
  clientId        String?          @db.Char(36)
  category        DocumentCategory @default(OTHER)
  title           String           @db.LongText
  description     String?          @db.LongText
  tags            Json             @default("[]")
  confidentiality Confidentiality  @default(STANDARD)
  status          DocumentStatus   @default(DRAFT)
  currentVersion  Int              @default(1)
  portalShared    Boolean          @default(false)
  // Denormalised searchable text of the current version (OCR / extraction)
  searchText      String?          @db.LongText
  createdById     String?          @db.Char(36)
  updatedById     String?          @db.Char(36)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  organization    Organization         @relation(fields: [organizationId], references: [id])
  matter          Matter?              @relation(fields: [matterId], references: [id])
  client          Client?              @relation(fields: [clientId], references: [id])
  versions        DocumentVersion[]
  permissions     DocumentPermission[]
  comments        Comment[]
  expenseReceipts Expense[]

  @@index([organizationId, matterId, deletedAt])
  @@index([organizationId, deletedAt, updatedAt])
  @@index([organizationId, status])
  // MySQL FULLTEXT (InnoDB) for extracted / OCR text and titles; results are permission-filtered afterwards.
  @@fulltext([searchText])
  @@fulltext([title])
}

model DocumentVersion {
  id                 String           @id @default(uuid()) @db.Char(36)
  documentId         String           @db.Char(36)
  version            Int
  fileName           String           @db.LongText
  storageKey         String           @unique @db.VarChar(191)
  mimeType           String           @db.LongText
  sizeBytes          BigInt
  checksumSha256     String           @db.LongText
  status             DocumentStatus   @default(DRAFT)
  comment            String?          @db.LongText
  uploadedById       String?          @db.Char(36)
  extractedText      String?          @db.LongText
  pageTexts          Json? // [{page: 1, text: "..."}] used for AI citations
  textStatus         ProcessingStatus @default(PENDING)
  pageCount          Int?
  // Malware scanning lifecycle. Nothing is served until CLEAN (or NOT_SCANNED when no scanner is configured).
  scanStatus         ScanStatus       @default(PENDING)
  scannedAt          DateTime?
  scanDetail         String?          @db.LongText
  // Integrity sweep: stored object re-hashed and compared with checksumSha256.
  integrityStatus    String?          @db.LongText // OK | MISMATCH | MISSING
  integrityCheckedAt DateTime?
  createdAt          DateTime         @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation(fields: [uploadedById], references: [id])

  @@unique([documentId, version])
  @@index([scanStatus])
}

enum ScanStatus {
  PENDING
  SCANNING
  CLEAN
  INFECTED
  ERROR
  NOT_SCANNED
}

enum DocumentAccess {
  VIEW
  EDIT
  DENY
}

model DocumentPermission {
  id         String         @id @default(uuid()) @db.Char(36)
  documentId String         @db.Char(36)
  userId     String?        @db.Char(36)
  roleId     String?        @db.Char(36)
  access     DocumentAccess
  createdAt  DateTime       @default(now())
  document   Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role?          @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// ═══════════════════════════ Collaboration ══════════════════════════════════

model Comment {
  id         String    @id @default(uuid()) @db.Char(36)
  authorId   String    @db.Char(36)
  matterId   String?   @db.Char(36)
  documentId String?   @db.Char(36)
  taskId     String?   @db.Char(36)
  body       String    @db.LongText
  mentions   Json      @default("[]") // user ids
  createdAt  DateTime  @default(now())
  editedAt   DateTime?
  deletedAt  DateTime?
  author     User      @relation(fields: [authorId], references: [id])
  matter     Matter?   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([matterId])
  @@index([documentId])
  @@index([taskId])
}

enum NoteVisibility {
  PRIVATE // author only
  TEAM // matter members
  CLIENT // explicitly shared with the client portal
}

model Note {
  id         String         @id @default(uuid()) @db.Char(36)
  matterId   String         @db.Char(36)
  authorId   String         @db.Char(36)
  visibility NoteVisibility @default(TEAM)
  body       String         @db.LongText
  pinned     Boolean        @default(false)
  sharedAt   DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?
  matter     Matter         @relation(fields: [matterId], references: [id], onDelete: Cascade)
  author     User           @relation(fields: [authorId], references: [id])

  @@index([matterId, visibility])
}

// Operational activity feed (distinct from the curated case timeline and the audit log)
model Activity {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  matterId       String?      @db.Char(36)
  actorId        String?      @db.Char(36)
  type           String       @db.LongText // e.g. hearing.rescheduled, document.uploaded
  entityType     String       @db.LongText
  entityId       String?      @db.Char(36)
  // i18n-able payload: { title, params }
  data           Json         @default("{}")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  matter         Matter?      @relation(fields: [matterId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@index([matterId, createdAt])
}

enum NotificationCategory {
  CRITICAL
  DEADLINE
  HEARING
  TASK
  DOCUMENT
  CLIENT
  FINANCE
  SYSTEM
}

model Notification {
  id             String                 @id @default(uuid()) @db.Char(36)
  organizationId String                 @db.Char(36)
  userId         String                 @db.Char(36)
  category       NotificationCategory
  title          String                 @db.LongText
  body           String?                @db.LongText
  link           String?                @db.LongText
  entityType     String?                @db.LongText
  entityId       String?                @db.Char(36)
  dedupeKey      String?                @db.VarChar(191)
  readAt         DateTime?
  snoozedUntil   DateTime?
  requiresAck    Boolean                @default(false)
  acknowledgedAt DateTime?
  createdAt      DateTime               @default(now())
  organization   Organization           @relation(fields: [organizationId], references: [id])
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries     NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

model NotificationDelivery {
  id             String       @id @default(uuid()) @db.Char(36)
  notificationId String       @db.Char(36)
  channel        String       @db.LongText // IN_APP | EMAIL | SMS | WHATSAPP | PUSH
  status         String       @db.VarChar(191) // PENDING | SENDING | SENT | SKIPPED_NOT_CONNECTED | FAILED
  error          String?      @db.LongText
  // Idempotency: exactly one delivery row per notification and channel.
  deliveryKey    String?      @unique @db.VarChar(191)
  provider       String?      @db.LongText
  attempts       Int          @default(0)
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?
  lockedUntil    DateTime?
  createdAt      DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

model Communication {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  matterId       String?      @db.Char(36)
  clientId       String?      @db.Char(36)
  channel        String       @db.LongText // EMAIL | CALL | MEETING | WHATSAPP | LETTER | NOTE
  direction      String       @default("OUTBOUND") @db.VarChar(191) // INBOUND | OUTBOUND | INTERNAL
  subject        String?      @db.LongText
  body           String?      @db.LongText
  occurredAt     DateTime
  userId         String?      @db.Char(36)
  externalRef    String?      @db.LongText
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  matter         Matter?      @relation(fields: [matterId], references: [id])
  client         Client?      @relation(fields: [clientId], references: [id])

  @@index([matterId, occurredAt])
  @@index([clientId, occurredAt])
}

// ═══════════════════════════ Finance ════════════════════════════════════════

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

model Invoice {
  id             String        @id @default(uuid()) @db.Char(36)
  organizationId String        @db.Char(36)
  number         String        @db.VarChar(191)
  clientId       String        @db.Char(36)
  matterId       String?       @db.Char(36)
  issueDate      DateTime
  dueDate        DateTime
  status         InvoiceStatus @default(DRAFT)
  currency       String        @default("AED") @db.VarChar(191)
  subtotal       Decimal       @default(0) @db.Decimal(14, 2)
  discount       Decimal       @default(0) @db.Decimal(14, 2)
  vatRate        Decimal       @default(5) @db.Decimal(5, 2)
  vatAmount      Decimal       @default(0) @db.Decimal(14, 2)
  total          Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(14, 2)
  notes          String?       @db.LongText
  portalVisible  Boolean       @default(false)
  createdById    String?       @db.Char(36)
  updatedById    String?       @db.Char(36)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id])
  client       Client        @relation(fields: [clientId], references: [id])
  matter       Matter?       @relation(fields: [matterId], references: [id])
  items        InvoiceItem[]
  payments     Payment[]

  @@unique([organizationId, number])
  @@index([organizationId, status, dueDate])
}

model InvoiceItem {
  id          String     @id @default(uuid()) @db.Char(36)
  invoiceId   String     @db.Char(36)
  kind        String     @default("FEE") @db.VarChar(191) // FEE | TIME | EXPENSE | DISBURSEMENT | COURT_FEE
  description String     @db.LongText
  quantity    Decimal    @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal    @db.Decimal(14, 2)
  amount      Decimal    @db.Decimal(14, 2)
  timeEntryId String?    @unique @db.Char(36)
  expenseId   String?    @unique @db.Char(36)
  order       Int        @default(0)
  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  timeEntry   TimeEntry? @relation(fields: [timeEntryId], references: [id])
  expense     Expense?   @relation(fields: [expenseId], references: [id])
}

model Payment {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  invoiceId      String       @db.Char(36)
  amount         Decimal      @db.Decimal(14, 2) // negative for refunds
  method         String       @db.LongText // BANK_TRANSFER | CARD | CASH | CHEQUE | OTHER
  receivedAt     DateTime
  reference      String?      @db.LongText
  notes          String?      @db.LongText
  isRefund       Boolean      @default(false)
  recordedById   String?      @db.Char(36)
  // Client-generated key per payment form: a double submission records the payment once.
  idempotencyKey String?      @unique @db.VarChar(64)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  invoice        Invoice      @relation(fields: [invoiceId], references: [id])

  @@index([organizationId, receivedAt])
}

