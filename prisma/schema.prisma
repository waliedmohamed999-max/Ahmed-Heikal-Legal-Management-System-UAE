  organization      Organization @relation(fields: [organizationId], references: [id])
  matter            Matter?      @relation(fields: [matterId], references: [id])
  receipt           Document?    @relation(fields: [receiptDocumentId], references: [id])
  invoiceItem       InvoiceItem?

  @@index([organizationId, incurredAt])
}

model TimeEntry {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  matterId       String       @db.Char(36)
  userId         String       @db.Char(36)
  activity       String       @db.LongText // RESEARCH | DRAFTING | MEETING | COURT | CALL | REVIEW | OTHER
  startedAt      DateTime
  endedAt        DateTime?
  minutes        Int          @default(0)
  billable       Boolean      @default(true)
  rate           Decimal?     @db.Decimal(10, 2)
